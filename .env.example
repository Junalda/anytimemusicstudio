# ─────────────────────────────────────────────────────────────
#  Anytime Music Studio — environment configuration
#  Copy this file to `.env` and fill in the real values.
#  Anything WITHOUT the PUBLIC_ prefix stays server/build-side only
#  and is never shipped to the browser as readable text.
# ─────────────────────────────────────────────────────────────

# WiFi credentials — used to build the native "join" QR code at
# build time. These are NEVER printed on the page as plain text.
WIFI_SSID="Anytime Music Studio"
WIFI_PASSWORD="change-me"
# WPA | WEP | nopass
WIFI_ENCRYPTION="WPA"
# Set to true only if the network name is hidden.
WIFI_HIDDEN="false"

# ── Public values (safe to expose in the browser) ──────────────

# Studio support WhatsApp number in full international format,
# digits only (no +, spaces or dashes). e.g. 31612345678
PUBLIC_WHATSAPP_NUMBER="31612345678"

# Optional support email shown on the Help screen.
PUBLIC_SUPPORT_EMAIL="hello@anytimemusic.studio"

# Optional endpoint the "Report an issue" form POSTs to
# (e.g. a Formspree / Basin / Web3Forms URL). Leave blank to fall
# back to opening the user's mail / WhatsApp client instead.
PUBLIC_ISSUE_FORM_ENDPOINT=""
