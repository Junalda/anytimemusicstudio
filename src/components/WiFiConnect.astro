---
import Icon from './Icon.astro';
import { studio } from '../config/studio';

/**
 * WiFiConnect
 * ───────────
 * House-rules agreement gate + a simple "Copy password" action.
 * After ticking the checkbox, the button copies the studio WiFi
 * password to the clipboard so the visitor can paste it in their
 * WiFi settings. The network name is shown; the password itself is
 * never rendered as readable text (base64 → clipboard only).
 */

// base64 so the password is not human-readable in the DOM / view-source.
const pwToken = Buffer.from(studio.wifi.password, 'utf-8').toString('base64');
---
<div class="wifi" id="wifi">
  <form class="wifi__agree" id="agree-form">
    <label class="check">
      <input type="checkbox" id="agree-checkbox" />
      <span class="check__box" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="15" height="15">
          <path d="M4.5 12.5 9.5 17.5 20 6.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
      <span class="check__label">I have read and agree to the House Rules.</span>
    </label>

    <p class="wifi__network">
      <Icon name="wifi" size={18} />
      <span>{studio.wifi.ssid}</span>
    </p>

    <button type="button" class="btn btn--primary" id="copy-pw" data-pw={pwToken} disabled>
      <Icon name="lock" size={20} />
      <span id="copy-pw-label">Copy password</span>
    </button>
  </form>
</div>

<style>
  .wifi__agree {
    display: grid;
    gap: 1.1rem;
  }
  .check {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 1.05rem 1.15rem;
    border-radius: var(--radius-md);
    background: var(--surface);
    border: 1px solid var(--hairline);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: border-color 0.25s var(--ease), background 0.25s var(--ease);
  }
  .check:has(input:checked) {
    border-color: rgba(246, 179, 199, 0.4);
    background: rgba(217, 87, 120, 0.08);
  }
  .check input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  .check__box {
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    border-radius: 8px;
    border: 1.5px solid var(--hairline-strong);
    display: grid;
    place-items: center;
    color: transparent;
    background: transparent;
    transition: all 0.25s var(--ease);
    margin-top: 1px;
  }
  .check input:checked + .check__box {
    background: var(--grad-rose);
    border-color: transparent;
    color: #1a0308;
  }
  .check input:focus-visible + .check__box {
    outline: 2px solid var(--rose-300);
    outline-offset: 2px;
  }
  .check__label {
    font-size: 1rem;
    line-height: 1.45;
    font-weight: 500;
  }

  .wifi__network {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    margin: 0.15rem auto 0;
    font-weight: 620;
    font-size: 1.08rem;
    color: var(--rose-100);
  }

  #copy-pw.copied {
    filter: none;
  }
</style>

<script>
  const checkbox = document.getElementById('agree-checkbox') as HTMLInputElement | null;
  const copyBtn = document.getElementById('copy-pw') as HTMLButtonElement | null;
  const copyLabel = document.getElementById('copy-pw-label');

  const STORAGE_KEY = 'ams:rules-accepted';

  function setAccepted(v: boolean) {
    if (copyBtn) copyBtn.disabled = !v;
    if (v) document.body.dispatchEvent(new CustomEvent('ams:rules-accepted'));
  }

  // Restore prior acceptance so returning visitors aren't re-gated,
  // while House Rules remain fully accessible on the page.
  try {
    if (localStorage.getItem(STORAGE_KEY) === '1' && checkbox) {
      checkbox.checked = true;
      setAccepted(true);
    }
  } catch {}

  checkbox?.addEventListener('change', () => {
    setAccepted(checkbox.checked);
    try {
      if (checkbox.checked) localStorage.setItem(STORAGE_KEY, '1');
      else localStorage.removeItem(STORAGE_KEY);
    } catch {}
  });

  copyBtn?.addEventListener('click', async () => {
    if (copyBtn.disabled) return;
    const token = copyBtn.dataset.pw ?? '';
    let password = '';
    try {
      password = decodeURIComponent(escape(atob(token)));
    } catch {
      password = atob(token);
    }
    try {
      await navigator.clipboard.writeText(password);
      copyBtn.classList.add('copied');
      if (copyLabel) copyLabel.textContent = 'Password copied';
      setTimeout(() => {
        copyBtn.classList.remove('copied');
        if (copyLabel) copyLabel.textContent = 'Copy password';
      }, 2200);
    } catch {
      if (copyLabel) copyLabel.textContent = 'Copy not available';
    }
  });
</script>
