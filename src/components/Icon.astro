---
/**
 * Minimal stroke-icon set. Add a new icon by adding a key to `paths`.
 * Icons are single-colour and inherit `currentColor`.
 */
interface Props {
  name: string;
  size?: number;
  class?: string;
  stroke?: number;
}
const { name, size = 24, class: klass = '', stroke = 1.6 } = Astro.props;

const paths: Record<string, string> = {
